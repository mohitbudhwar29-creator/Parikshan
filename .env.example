# Copy to .env (never commit real secrets).

# Local SQLite database file (libsql driver adapter). Relative to the project root.
DATABASE_URL="file:./prisma/dev.db"

# Signs the demo session cookie (HMAC-SHA256). Use a long random value outside local demos.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string-for-local-use"

# Where uploaded documents are stored (outside /public, served only through an ownership check).
UPLOAD_DIR="./storage/uploads"

# Provider selection. "mock" is the default and needs no credentials.
OCR_PROVIDER="mock"
AI_PROVIDER="mock"
INTERACTION_PROVIDER="mock"

# Future production providers (not required for the demo). Keep keys on the server only.
# OCR_API_KEY=""
# AI_API_KEY=""
# AI_MODEL="..."

# Voice assistant (see docs/voice.md). Defaults work with no credentials.
# VOICE_ENABLED="true"
# Speech to text and text to speech: "browser" (default, Web Speech API, no server key),
# "openai" (audio goes to the OpenAI API from the server; needs OPENAI_API_KEY), or "off".
# An "openai" setting without a key is treated as "off" and reported as misconfigured.
# VOICE_STT_PROVIDER="browser"
# VOICE_TTS_PROVIDER="browser"
# OPENAI_API_KEY="" # server only, never prefixed with NEXT_PUBLIC_
# VOICE_OPENAI_STT_MODEL="whisper-1"
# VOICE_OPENAI_TTS_MODEL="tts-1"
# VOICE_OPENAI_TTS_VOICE="alloy"
# Largest recording accepted for server speech to text (bytes). Capped at 20 MB.
# VOICE_MAX_AUDIO_BYTES="5242880"
# Voice requests per signed-in user per minute. In memory, per server process (see docs/voice.md).
# VOICE_RATE_LIMIT_PER_MINUTE="20"
