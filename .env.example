# Copy to .env (never commit real secrets).

# Local SQLite database file (libsql driver adapter). Relative to the project root.
DATABASE_URL="file:./prisma/dev.db"

# Signs the demo session cookie (HMAC-SHA256). Use a long random value outside local demos.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string-for-local-use"

# Where uploaded documents are stored (outside /public, served only through an ownership check).
UPLOAD_DIR="./storage/uploads"

# Provider selection. "mock" is the default and needs no credentials.
OCR_PROVIDER="mock"
AI_PROVIDER="mock"
INTERACTION_PROVIDER="mock"

# Future production providers (not required for the demo). Keep keys on the server only.
# OCR_API_KEY=""
# AI_API_KEY=""
# AI_MODEL="..."
